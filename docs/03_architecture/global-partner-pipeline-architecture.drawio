        <mxCell id="0rUjjzxP_Eel8r8tKNUb-43" parent="0rUjjzxP_Eel8r8tKNUb-182" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;labelBackgroundColor=default;" value="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;LEGEND&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;━━━ blue solid&amp;nbsp; &amp;nbsp; &amp;nbsp;data flow&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- - - orange dashed control (MWAA starts job)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;····· grey dotted&amp;nbsp; &amp;nbsp;logs, secrets, bookkeeping&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- - - purple dashed deployment&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;■ green fill&amp;nbsp; &amp;nbsp;DataStack: permanent (S3 lake, KMS, ECR)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;□ no fill&amp;nbsp; &amp;nbsp; &amp;nbsp; PipelineStack: created on demand, destroyed after&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;DAILY RUN&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;① Replay inserts the day&#39;s orders into SQL Server&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;② 06:00 MWAA starts the DAG&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;③ Extract new rows (watermark − 3 days) → bronze&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;④ Clean, type, flag → silver; bad rows → quarantine&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;⑤ Facts + dimensions → gold (MERGE)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;⑥ Daily CLV snapshot, sales_daily&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;⑦ DQ checks; any failure → alarm → email&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;⑧ Users: HTTPS → ALB → Streamlit → Athena → gold&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;FAILURE RELOAD&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Each task retries 2×; later tasks wait&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Watermark moves only on success&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• MERGE: reruns never duplicate&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;• Iceberg time travel rolls back a bad load&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="570" width="370" x="1680" y="610" as="geometry" />
        </mxCell>
