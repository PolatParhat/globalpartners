n-scope)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontColor=#3A6B2A;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_order" target="snapshot"><mxGeometry relative="1" x="0.75" as="geometry"><Array as="points"><mxPoint x="764" y="1015"/><mxPoint x="310" y="1015"/></Array></mxGeometry></mxCell><mxCell id="built1" value="sum by date, location, hour" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontColor=#3A6B2A;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_order" target="sales_daily"><mxGeometry relative="1" x="0.75" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="built2" value="sum by date, location, category" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontColor=#3A6B2A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_order_line" target="sales_daily_category"><mxGeometry relative="1" x="0.75" as="geometry"><Array as="points"><mxPoint x="990" y="455"/><mxPoint x="990" y="1015"/><mxPoint x="1280" y="1015"/></Array></mxGeometry></mxCell><mxCell id="sep" value="metric tables for the dashboard (rebuilt every run)" style="endArrow=none;dashed=1;html=1;strokeColor=#82B366;strokeWidth=1;fontSize=12;fontColor=#3A6B2A;labelBackgroundColor=#FFFFFF;align=left;labelPosition=right;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="990" as="sourcePoint"/><mxPoint x="1420" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;GlobalPartners: Gold Data Model (star schema)&lt;/b&gt; · v1 2026-10-09" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Source: silver.order_items + silver.order_item_options + silver.date_dim. Full column specs: Step3_Data_Model.md" style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="24" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6C8EBF&quot;&gt;■&lt;/span&gt; fact table (events, numbers)&lt;br&gt;&lt;span style=&quot;color:#D6B656&quot;&gt;■&lt;/span&gt; dimension (who / what / where / when)&lt;br&gt;&lt;span style=&quot;color:#82B366&quot;&gt;■&lt;/span&gt; metric table for the dashboard&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key&lt;br&gt;||——&amp;lt; one-to-many (one dimension row, many fact rows);&lt;br&gt;each line joins the FK to the PK of the same name&lt;br&gt;&lt;span style=&quot;color:#82B366&quot;&gt;- - -▶&lt;/span&gt; built from&lt;br&gt;&lt;br&gt;&lt;b&gt;SCOPE OF METRIC TABLES&lt;/b&gt;&lt;br&gt;2023 · test data excluded&lt;br&gt;snapshot: guests + non-customer account excluded&lt;br&gt;sales: guests + non-customer account included&lt;br&gt;&lt;br&gt;&lt;b&gt;KEY RULES&lt;/b&gt;&lt;br&gt;CLV = revenue_to_date (2023 orders)&lt;br&gt;revenue = item_price + Σ option_price × qty&lt;br&gt;order counts only in sales_daily&lt;br&gt;(not additive across categories)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1440" y="140" width="250" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>